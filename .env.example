# Telephony bridge
NODE_ENV=development
PORT=8080
AWS_REGION=ap-northeast-1
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
TOOL_ROUTER_URL=https://xxx.execute-api.ap-northeast-1.amazonaws.com
RECORDINGS_S3_BUCKET=aicc2-dev-recordings-000000000000
KMS_KEY_ARN=arn:aws:kms:ap-northeast-1:000000000000:key/...

# Tool router
DATABASE_URL=postgresql://app:password@aurora:5432/aicc2?sslmode=require
PATIENT_FORM_BASE_URL=https://form.dev.aicc2.example
SMS_ORIGINATION_ID=PoolIdOrSenderId

# Admin web
NEXT_PUBLIC_BUILD_ENV=dev
COGNITO_USER_POOL_ID=ap-northeast-1_xxxx
COGNITO_CLIENT_ID=xxxx

# Local Postgres pgcrypto key (set as session-level GUC by Prisma middleware)
PII_KEY=replace-me-with-secrets-manager-value
